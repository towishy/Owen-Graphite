!docs/v3/**

# Local screenshots draft (final ones live in screenshots/)
screenshots-raw/
screenshots-draft/
screenshots/fixture-regression/

# v3 rewrite: keep golden baselines tracked
!screenshots/golden/
!screenshots/golden/**
*.psd
*.xd
