# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Obsidian (only if accidentally cloned into a vault)
.obsidian/
*.tmp
data.json

# Node (none expected, but safe)
node_modules/
package-lock.json

# Python
.venv/
__pycache__/
*.py[cod]

# Build artifacts
*.log
dist/
build/

# Dev temporary request artifacts
dev/temp/*
!dev/temp/.gitignore

# v3 rewrite harness (golden rig HTML fixtures and supporting assets)
!dev/v3/
!dev/v3/**

# Workspace-root one-off preview artifacts
.temp/

