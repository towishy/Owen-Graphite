# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Obsidian (only if accidentally cloned into a vault)
.obsidian/
*.tmp
data.json

# Node (none expected, but safe)
node_modules/
package-lock.json

# Python
.venv/
__pycache__/
*.py[cod]

# Build artifacts
*.log
dist/
build/

# Dev temporary request artifacts
dev/temp/*
!dev/temp/.gitignore

# Local documentation workspace (allow QA fixtures and validator-owned docs)
docs/*
!docs/fixtures/
!docs/fixtures/**
!docs/qa-checklist.md
!docs/css-important-audit.md
!docs/liquid-glass-token-map.md
!docs/liquid-glass-core-principles.md

# Local screenshots draft (final ones live in screenshots/)
screenshots-raw/
screenshots-draft/
screenshots/fixture-regression/
*.psd
*.xd
